# Server Configuration
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:4000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/ironman_gym

# JWT & Cookie Authentication
JWT_SECRET=ironman-gym-super-secret-jwt-key-2026
JWT_EXPIRES_IN=7d
COOKIE_NAME=ironman_token

# Image Upload Storage Engine: 'local' (default) or 'cloudinary'
STORAGE_PROVIDER=local

# Cloudinary Setup (Optional - activates if STORAGE_PROVIDER=cloudinary or credentials are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Default SuperAdmin Seed Credentials
DEFAULT_SUPERADMIN_EMAIL=superadmin@ironman.com
DEFAULT_SUPERADMIN_PASSWORD=Admin@123456

# Resend Email Configuration (Paste your Resend API Key here for live inbox delivery)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Fitness First Gym <onboarding@resend.dev>
